---
const socials = [
  { name: 'Instagram', url: 'https://www.instagram.com/6milestomixon' },
  { name: 'Facebook', url: 'https://www.facebook.com/6milestomixon' },
  { name: 'YouTube', url: 'https://www.youtube.com/@6milestomixon404' },
  { name: 'Spotify', url: 'https://open.spotify.com/artist/3GbbdkhKOBAyDsx5x5Xjtm' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="6 Miles to Mixon brings country roots and good times to East Texas. Find upcoming shows, hear the band, and book your next event." />
  <meta name="theme-color" content="#1c211e" />
  <title>6 Miles to Mixon | Country Roots. Good Times.</title>
  <link rel="icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="nav-container">
      <a class="brand" href="/" aria-label="6 Miles to Mixon home"><img src="/logo.png" width="54" height="62" alt="6 Miles to Mixon" /></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="#events">Shows</a><a href="#about">The Band</a><a href="#music">Music</a><a class="nav-book" href="#contact">Book the Band</a>
      </nav>
      <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span><span></span></button>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
      <a href="#events">Upcoming Shows</a><a href="#about">The Band</a><a href="#music">Music</a><a href="#contact">Book the Band</a>
    </nav>
  </header>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="poster">
        <p class="eyebrow poster-top">TYLER, TEXAS <span>EST. IN EAST TEXAS</span></p>
        <div class="hero-layout">
          <div class="hero-copy">
            <p class="eyebrow band-name">6 MILES TO MIXON</p>
            <h1 id="hero-title">COUNTRY ROOTS.<br /><span>GOOD TIMES.</span></h1>
            <p class="hero-description">Classic country. New favorites. A little rock.<br class="desktop-break" /> Come out, sing along, and stay awhile.</p>
            <div class="hero-actions"><a class="button primary" href="#events">Upcoming Shows</a><a class="button secondary" href="#contact">Book the Band</a></div>
          </div>
          <div class="hero-emblem"><img src="/logo.png" alt="6 Miles to Mixon highway sign" width="340" height="390" fetchpriority="high" /><p>COUNTRY MUSIC · EAST TEXAS</p></div>
        </div>
        <div class="poster-bottom"><span>GOOD SONGS. GREAT COMPANY.</span><a href="#music">Hear the band</a></div>
      </div>
    </section>
    <div class="ribbon" aria-label="Available for venues, weddings, festivals and private events">VENUES <span>·</span> WEDDINGS <span>·</span> FESTIVALS <span>·</span> PRIVATE EVENTS</div>
    <section id="events" class="shows section-pad">
      <div class="section-inner">
        <div class="section-heading"><div><p class="eyebrow">MEET US OUT THERE</p><h2>Upcoming shows</h2></div><p>A night of country music.<br />A dance floor waiting for you.</p></div>
        <div class="shows-widget">
          <script charset="utf-8" src="https://widgetv3.bandsintown.com/main.min.js" async></script>
          <a class="bit-widget-initializer" data-artist-name="id_15084055" data-layout-breakpoint="900" data-app-id="faaf86239b8fa07dd618151a0c680c0c" data-background-color="transparent" data-text-color="#262b27" data-link-color="#735523" data-display-local-dates="false" data-display-past-dates="false" data-display-limit="6"></a>
        </div>
        <p class="shows-fallback">For show announcements, follow us on <a href="https://www.facebook.com/6milestomixon">Facebook</a>.</p>
      </div>
    </section>
    <section id="about" class="about section-pad">
      <div class="section-inner about-grid">
        <div class="band-photo"><img src="/hero.jpg" alt="6 Miles to Mixon performing together" loading="lazy" width="1200" height="800" /><p>6 MILES TO MIXON · EAST TEXAS</p></div>
        <div class="about-copy"><p class="eyebrow">RIGHT AT HOME ON STAGE</p><h2>A little country.<br />A whole lot of heart.</h2><p>We’re 6 Miles to Mixon, a country band from the Tyler, Texas area. Our set brings together classic country, modern favorites, a little rock, and a few songs of our own.</p><p>From a local venue to a wedding, festival, or company party, we bring strong vocals, tight musicianship, and songs you’ll want to sing along to.</p><a class="text-link" href="/EPK.pdf">Download our press kit</a></div>
      </div>
    </section>
    <section id="music" class="music section-pad">
      <div class="section-inner"><div class="section-heading"><div><p class="eyebrow">TURN IT UP</p><h2>Get to know the sound</h2></div><a class="text-link" href="https://www.youtube.com/@6milestomixon404">More on YouTube</a></div>
        <div class="music-grid"><div class="video-wrap"><iframe title="Watch 6 Miles to Mixon" src="https://www.youtube.com/embed/Gy-i5RsI2Es" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div><iframe class="spotify-player" title="Listen to 6 Miles to Mixon on Spotify" src="https://open.spotify.com/embed/artist/3GbbdkhKOBAyDsx5x5Xjtm?theme=0" width="100%" height="352" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe></div>
      </div>
    </section>
    <section id="contact" class="contact section-pad"><div class="section-inner contact-inner"><p class="eyebrow">LET’S MAKE A NIGHT OF IT</p><h2>YOUR PLACE.<br /><span>OUR KIND OF COUNTRY.</span></h2><p>Booking a venue, wedding, festival, or private event?<br />Tell us the date, the place, and what you have in mind.</p><form class="booking-form" action="https://formsubmit.co/contact@6milestomixon.com" method="POST" aria-label="Band booking inquiry">
          <input type="hidden" name="_subject" value="New booking inquiry — 6 Miles to Mixon" />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="booking-grid">
            <div class="form-field"><label for="booking-name">Your name</label><input id="booking-name" name="name" type="text" autocomplete="name" maxlength="100" required /></div>
            <div class="form-field"><label for="booking-email">Email address</label><input id="booking-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
            <div class="form-field"><label for="booking-date">Event date <span>(optional)</span></label><input id="booking-date" name="Event date" type="date" /><small>Still deciding? Leave this blank.</small></div>
            <div class="form-field"><label for="booking-type">Event type</label><select id="booking-type" name="Event type" required><option value="" disabled selected>Select an event type</option>Venue / restaurant / bar</option><option>Wedding</option><option>Festival</option><option>Corporate event</option><option>Private party</option><option>Other</option></select></div>
            <div class="form-field form-wide"><label for="booking-location">Venue or city</label><input id="booking-location" name="Location" type="text" placeholder="Where’s the party?" maxlength="200" required /></div>
            <div class="form-field form-wide"><label for="booking-details">Tell us a little more <span>(optional)</span></label><textarea id="booking-details" name="Details" rows="4" maxlength="3000" placeholder="Performance times, estimated guest count, or anything else we should know."></textarea></div>
          </div>
          <p class="form-note">We’ll use your details to respond to your booking inquiry. Submitting this form does not reserve a date.</p>
          <button class="button primary booking-submit" type="submit">Send Booking Inquiry</button>
          <p class="form-help">You’ll complete a quick spam check to send your inquiry. Having trouble? Email us below.</p>
        </form><a class="contact-email" href="mailto:contact@6milestomixon.com">contact@6milestomixon.com</a></div></section>
  </main>
  <footer><div class="footer-inner"><a href="/" aria-label="6 Miles to Mixon home"><img src="/logo.png" alt="6 Miles to Mixon" width="65" height="75" loading="lazy" /></a><p>Country roots. Good times.<br /><span>© {new Date().getFullYear()} 6 Miles to Mixon</span></p><nav aria-label="Social media">{socials.map(social => <a href={social.url}>{social.name}</a>)}</nav></div></footer>
  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = document.querySelector<HTMLElement>('#mobile-nav');
    const setMenu = (open: boolean) => {
      if (!toggle || !menu) return;
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.classList.toggle('open', open);
    };
    toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', event => { if (event.key === 'Escape') { setMenu(false); toggle?.focus(); } });
    document.addEventListener('click', event => { if (event.target instanceof Node && !document.querySelector('.site-header')?.contains(event.target)) setMenu(false); });
    window.matchMedia('(min-width: 769px)').addEventListener('change', event => { if (event.matches) setMenu(false); });
  </script>
</body>
</html>
<style is:global>
  :root{--ink:#1c211e;--cream:#f3ead6;--gold:#d6ab58;--muted:#c5c5b8;--line:rgba(243,234,214,.22)}
  *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:88px}body{margin:0;background:var(--ink);color:var(--cream);font-family:Inter,Arial,sans-serif;font-size:1rem;line-height:1.65}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}img{display:block;max-width:100%;height:auto}button,a{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible{outline:3px solid var(--gold);outline-offset:5px}h1,h2,p{margin:0}h1,h2{font-family:Oswald,'Arial Narrow',Impact,sans-serif;font-weight:600;line-height:1.08}h2{font-size:clamp(2.25rem,4vw,3.75rem)}.eyebrow{font-size:.875rem;font-weight:700;letter-spacing:.16em;line-height:1.5}.skip-link{position:absolute;left:12px;top:-100px;background:var(--cream);color:var(--ink);padding:12px;z-index:99}.skip-link:focus{top:12px}
  .site-header{position:sticky;top:0;background:rgba(28,33,30,.98);border-bottom:1px solid var(--line);z-index:20}.nav-container{max-width:1260px;margin:auto;padding:10px 30px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand img{width:46px;height:54px;object-fit:contain}.desktop-nav{display:flex;align-items:center;gap:32px;font-size:.875rem;font-weight:600}.nav-book{border:1px solid var(--gold);padding:10px 18px;color:var(--gold)}.menu-toggle{display:none;width:44px;height:44px;background:none;border:1px solid var(--line);align-items:center;justify-content:center;flex-direction:column;gap:5px;cursor:pointer}.menu-toggle span{height:2px;width:20px;background:var(--cream);transition:transform .2s}.menu-toggle.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}.menu-toggle.open span:nth-child(2){opacity:0}.menu-toggle.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}.mobile-nav[hidden]{display:none}.mobile-nav{padding:12px 24px 24px;border-top:1px solid var(--line);display:grid;gap:4px;max-height:calc(100dvh - 75px);overflow:auto}.mobile-nav a{padding:12px 0;font-weight:600}
  .hero{padding:28px 30px 32px;background:radial-gradient(ellipse at 70% 35%,#343a2e 0%,#242a23 40%,var(--ink) 80%)}.poster{max-width:1200px;margin:auto;padding:22px 36px 0;border:1px solid rgba(214,171,88,.65);outline:1px solid rgba(214,171,88,.2);outline-offset:-7px}.poster-top{display:flex;justify-content:space-between;color:var(--gold);border-bottom:1px solid var(--line);padding-bottom:16px;letter-spacing:.17em}.hero-layout{display:grid;grid-template-columns:1.7fr 1fr;align-items:center;gap:42px;padding:42px 0 48px}.band-name{color:var(--gold);margin-bottom:20px}.hero h1{font-size:clamp(3.25rem,6.4vw,5.6rem);letter-spacing:-.025em;line-height:1.1}.hero h1 span{color:var(--gold)}.hero-description{color:#dedbce;margin-top:24px;max-width:540px;font-size:1.0625rem}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.button{display:inline-flex;align-items:center;justify-content:center;padding:14px 22px;font-weight:700;font-size:.9375rem;min-height:50px;border:1px solid var(--gold);transition:background .2s,color .2s}.button:hover{text-decoration:none;background:var(--cream);color:var(--ink);border-color:var(--cream)}.primary{background:var(--gold);color:var(--ink)}.secondary{color:var(--cream);border-color:var(--line)}.hero-emblem{display:flex;align-items:center;flex-direction:column;text-align:center}.hero-emblem img{width:min(100%,280px);filter:drop-shadow(0 15px 20px rgba(0,0,0,.2))}.hero-emblem p{font-size:.875rem;letter-spacing:.13em;margin-top:22px;color:var(--gold);font-weight:600}.poster-bottom{border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;padding:18px 0;font-size:.875rem;letter-spacing:.1em}.poster-bottom a{color:var(--gold);letter-spacing:0}.ribbon{background:var(--gold);color:var(--ink);text-align:center;display:flex;justify-content:center;gap:24px;padding:16px 24px;font-size:.875rem;letter-spacing:.12em;font-weight:700;flex-wrap:wrap}
  .section-pad{padding:80px 30px}.section-inner{max-width:1128px;margin:auto}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:36px}.section-heading .eyebrow,.about .eyebrow{color:var(--gold);margin-bottom:14px}.section-heading>p{color:var(--muted)}.shows{background:var(--cream);color:var(--ink)}.shows .eyebrow{color:#735523}.shows .section-heading>p{color:#555d54}.shows-widget{border-top:1px solid #c8c1af;border-bottom:1px solid #c8c1af;min-height:100px;padding:12px 0}.shows-fallback{font-size:.875rem;margin-top:20px;color:#555d54}.shows-fallback a{text-decoration:underline;color:#735523}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.band-photo{background:#111713;padding:12px;border:1px solid var(--line);transform:rotate(-2deg)}.band-photo img{width:100%;height:auto}.band-photo p{font-size:.875rem;font-weight:600;letter-spacing:.08em;padding:16px 6px 4px;color:var(--gold)}.about-copy>p:not(.eyebrow){color:#d2d3c7;margin-top:22px}.text-link{display:inline-block;color:var(--gold);text-decoration:underline;text-underline-offset:5px;font-weight:600;font-size:.9375rem}.about-copy .text-link{margin-top:24px}.music{background:#141a16;border-top:1px solid var(--line)}.music-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:24px;align-items:start}.video-wrap{aspect-ratio:16/9;background:#090c0a;border:1px solid var(--line)}.video-wrap iframe{width:100%;height:100%;border:0;display:block}.spotify-player{border:0;border-radius:12px;display:block}.contact{text-align:center;border-top:1px solid var(--line);background:radial-gradient(ellipse at 50% 100%,#343a2e,var(--ink) 75%)}.contact .eyebrow{color:var(--gold);margin-bottom:24px}.contact h2{font-size:clamp(2.5rem,5.4vw,4.75rem)}.contact h2 span{color:var(--gold)}.contact p:not(.eyebrow){margin:26px 0;color:#d2d3c7}.contact-email{display:block;font-size:.9375rem;margin-top:18px;overflow-wrap:anywhere;color:var(--muted)}footer{border-top:1px solid var(--line);padding:34px 30px;background:#141a16}.footer-inner{max-width:1128px;margin:auto;display:flex;align-items:center;gap:24px}.footer-inner img{width:52px}.footer-inner p{font-size:.9375rem}.footer-inner p span{font-size:.875rem;color:var(--muted)}footer nav{margin-left:auto;display:flex;gap:20px;flex-wrap:wrap;font-size:.875rem;color:var(--gold)}
  @media(max-width:1000px){.hero-layout{gap:24px}.hero-emblem img{width:230px}.about-grid{gap:36px}.hero h1{font-size:clamp(3rem,6.3vw,4.75rem)}}
  @media(max-width:768px){html{scroll-padding-top:80px}.nav-container{padding:8px 20px}.desktop-nav{display:none}.menu-toggle{display:flex}.hero{padding:16px 16px 20px}.poster{padding:18px 20px 0}.poster-top{font-size:.75rem}.poster-top span{display:none}.hero-layout{display:flex;flex-direction:column-reverse;gap:22px;padding:25px 0 28px;text-align:center}.hero-emblem img{width:110px}.hero-emblem p{display:none}.band-name{font-size:.8125rem;margin-bottom:14px}.hero h1{font-size:clamp(2.7rem,10.2vw,4.4rem);letter-spacing:-.025em}.hero-description{font-size:1rem;margin-top:18px}.desktop-break{display:none}.hero-actions{margin-top:24px;gap:10px;justify-content:center}.button{padding:13px 16px;font-size:.875rem}.poster-bottom{font-size:.75rem;letter-spacing:.04em;padding:14px 0;align-items:center}.poster-bottom a{font-size:.875rem}.ribbon{gap:8px 12px;font-size:.75rem;letter-spacing:.06em;padding:14px 16px}.section-pad{padding:54px 22px}.section-heading{display:block;margin-bottom:28px}.section-heading>p,.section-heading>.text-link{margin-top:18px}.about-grid{grid-template-columns:1fr;gap:36px}.about-copy{order:-1}.music-grid{grid-template-columns:1fr}.contact h2{font-size:clamp(2.2rem,8.5vw,3.7rem)}.contact p br{display:none}.footer-inner{flex-wrap:wrap;gap:18px}footer nav{width:100%;margin-left:0;gap:18px}.eyebrow{letter-spacing:.12em}}
  @media(max-width:360px){.hero-actions{flex-direction:column}.hero h1{font-size:2.5rem}.poster-bottom{flex-direction:column;gap:8px}.ribbon{letter-spacing:0}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important}}

  .booking-form{max-width:740px;margin:36px auto 0;padding:30px;border:1px solid var(--line);background:#161d18;text-align:left}.booking-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px}.form-field{min-width:0}.form-wide{grid-column:1/-1}.form-field label{display:block;font-size:.9375rem;font-weight:600;margin-bottom:8px}.form-field label span{color:var(--muted);font-weight:400}.form-field input,.form-field select,.form-field textarea{display:block;width:100%;min-width:0;max-width:100%;min-height:50px;border:1px solid #777d70;border-radius:3px;background:#f3ead6;color:#1c211e;padding:12px;font:inherit;font-size:1rem;line-height:1.5;color-scheme:light}.form-field input:focus,.form-field select:focus,.form-field textarea:focus{outline:3px solid var(--gold);outline-offset:3px}.form-field textarea{resize:vertical}.form-field input::placeholder,.form-field textarea::placeholder{color:#626459;opacity:1}.form-field small{display:block;color:var(--muted);font-size:.875rem;margin-top:6px}.contact .booking-form .form-note,.contact .booking-form .form-help{font-size:.875rem;line-height:1.6;color:var(--muted);margin:20px 0}.contact .booking-form .form-help{margin:14px 0 0}.booking-submit{font-family:inherit;cursor:pointer;width:100%}.form-honeypot{display:none!important}
  @media(max-width:600px){.booking-form{padding:22px 16px;margin-top:28px}.booking-grid{grid-template-columns:minmax(0,1fr);gap:20px}.form-wide{grid-column:auto}}
</style>
